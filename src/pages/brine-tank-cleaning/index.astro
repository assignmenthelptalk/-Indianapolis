---
import Layout from "../../components/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import QuickFacts from "../../components/QuickFacts.astro";
import { site } from "../../lib/site";
import headerImage from "../../assets/images/brine-tank-cleaning-header.webp";

const primaryCta = site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER"
  ? { href: `tel:${site.phoneNumber}`, text: `📞 ${site.phoneNumber}` }
  : { href: "/contact/", text: "📞 Call for a Free Consultation" };

const signs = [
  {
    name: "Salt Bridge",
    detail: "A hardened crust forms above the water level in the brine tank, so salt fails to dissolve into the water even though the tank looks full.",
  },
  {
    name: "Salt Mush",
    detail: "Salt dissolves into a thick sludge at the bottom of the tank instead of a clean brine solution, blocking the float valve and intake screen.",
  },
  {
    name: "Standing Water",
    detail: "Brine water that fails to drain down during regeneration usually points to a clogged injector or a stuck float valve.",
  },
  {
    name: "Hard Water Despite Regeneration",
    detail: "If the tank fails to produce usable brine, the resin bed misses its proper recharge, and water tests hard even on schedule.",
  },
];

const faqs = [
  {
    q: "How often does a water softener brine tank need cleaning?",
    a: "Most manufacturers recommend cleaning the brine tank once a year as part of routine maintenance, more often in areas with very hard water or high iron content.",
  },
  {
    q: "Can I clean my own brine tank?",
    a: "Yes, for routine cleaning — drain it, remove leftover salt, scrub with soap and water, and rinse thoroughly. A hardened salt bridge or a stuck float valve often needs a professional diagnostic.",
  },
  {
    q: "What causes a salt bridge?",
    a: "High humidity, using an incompatible salt type, or overfilling the tank all encourage salt to fuse into a solid crust above the water line.",
  },
  {
    q: "Does a dirty brine tank damage the softener?",
    a: "Yes — over time it can affect the resin bed's ability to fully regenerate, shortening the resin's effective lifespan and reducing softening performance.",
  },
];
---

<Layout
  title={`Water Softener Brine Tank Cleaning in ${site.city}, ${site.stateAbbr}`}
  description={`Signs your ${site.city} water softener's brine tank needs cleaning, what it costs, and how the process works.`}
>
  <PageHero
    breadcrumbs={[{ label: "Repair", href: "/repair/" }, { label: "Brine Tank Cleaning" }]}
    heading={`Brine Tank Cleaning in ${site.city}, ${site.stateAbbr} | Trusted Local Specialists`}
    image={headerImage}
    primaryCta={primaryCta}
    secondaryCta={{ href: "/quote/", text: "Get a Free Water Softener Quote in Indianapolis" }}
  >
    <p slot="opening">
      <a href="/" class="brand-link">Water Softeners of {site.city}</a>
      {" "}offers water softener brine tank cleaning at {site.gpgLow}-{site.gpgHigh} GPG, such as salt bridge
      clearing, float valve inspection, and annual maintenance, across {site.city} and {site.county}. Annual
      cleaning is recommended at this hardness level. Salt bridges, salt mushing, and dirty brine reduce
      regeneration effectiveness by up to 50%, per manufacturer specifications, and waste salt. Free
      diagnostic included with every cleaning call. Same day availability.
    </p>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p>The brine tank holds the salt solution a water softener uses to regenerate its resin bed. At {site.gpgLow}-{site.gpgHigh} GPG, {site.city} softeners — such as single-tank and dual-tank units — regenerate more often than in a moderate-hardness market, which means more salt cycling through the tank and a shorter interval before it needs attention.</p>
      </div>

      <h2>Why Your Brine Tank Needs Cleaning</h2>
      <p>{site.waterAuthority} data shows these four signs link directly to brine tank issues at {site.city}'s hardness level.</p>
      <div class="grid grid-2">
        {signs.map((s) => (
          <div class="card">
            <p class="card-title">{s.name}</p>
            <p>{s.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <QuickFacts />

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header">
        <h2>Brine Tank Cleaning Cost</h2>
        <p>Most manufacturers consider brine tank cleaning routine maintenance rather than a repair, so it's typically bundled with an annual service visit at a modest fixed cost. {site.waterAuthority} reports the same {site.gpgLow}-{site.gpgHigh} GPG figure behind every quote — clearing a hardened salt bridge or replacing a stuck float valve costs more, depending on what's found during diagnosis.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header center">
        <h2>How Brine Tank Cleaning Works</h2>
        <p>{site.waterAuthority} reports the same figure behind every step below in {site.city}'s real {site.gpgLow}-{site.gpgHigh} GPG hardness reading, across three stages.</p>
      </div>
      <div class="grid grid-3">
        <div class="process-step">
          <span class="process-number">1</span>
          <p class="card-title">Drain and Empty</p>
          <p>Bypass the softener, drain remaining brine, and remove any leftover salt, sludge, or a hardened bridge.</p>
        </div>
        <div class="process-step">
          <span class="process-number">2</span>
          <p class="card-title">Clean and Inspect</p>
          <p>Scrub the tank with soap and water, then inspect the float valve, injector, and grid plate for buildup or damage.</p>
        </div>
        <div class="process-step">
          <span class="process-number">3</span>
          <p class="card-title">Refill and Test</p>
          <p>Refill with fresh salt, run a manual regeneration cycle, and confirm the system produces usable brine again — get a free quote to schedule yours.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header">
        <h2>Connection to Resin Bed Performance</h2>
        <p>A dirty brine tank starves the resin bed of the concentrated brine it needs to fully regenerate. Left unaddressed, it can shorten resin lifespan the same way heavy iron or chlorine exposure does, per manufacturer specifications — see our <a href="/resin-bed-replacement/">Water Softener Resin Bed Replacement in Indianapolis</a> page if the resin itself has already failed.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header center">
        <h2>Brine Tank Cleaning Questions</h2>
        <p>{site.waterAuthority} reports the same figure behind every answer below in {site.city}'s real {site.gpgLow}-{site.gpgHigh} GPG hardness reading.</p>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>
              {item.q}
              <svg class="faq-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6.5 8 10.5 12 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container final-cta">
      <h2>Brine Tank Acting Up in {site.city}?</h2>
      <p>{site.waterAuthority} reports the same {site.gpgLow}-{site.gpgHigh} GPG figure behind every diagnostic — get a free in-home test to confirm whether the brine tank is the cause.</p>
      <a class="btn btn-primary" href="/contact/">Book a Diagnostic →</a>
    </div>
  </section>

  <style>
    .process-step { text-align: center; padding: 0 12px; }
    .process-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: var(--radius-full, 9999px);
      background: var(--color-primary-light);
      color: var(--color-primary);
      font-family: var(--font-heading);
      font-size: 1.125rem;
      margin-bottom: 14px;
    }
    .card-title { font-family: var(--font-heading); font-size: 1.1rem; color: var(--surface-footer); margin: 0 0 8px; }
    .faq-list { max-width: 760px; margin: 24px auto 0; }
    .final-cta { text-align: center; }
    .final-cta p { max-width: 48ch; margin: 0 auto 24px; }
  </style>
</Layout>
