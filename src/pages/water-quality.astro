---
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import GPGSlider from "../components/GPGSlider.astro";
import QuickFacts from "../components/QuickFacts.astro";
import { site } from "../lib/site";
import headerImage from "../assets/images/water-quality-header.webp";

const primaryCta = site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER"
  ? { href: `tel:${site.phoneNumber}`, text: `📞 ${site.phoneNumber}` }
  : { href: "/contact/", text: "📞 Call for a Free Consultation" };
---

<Layout
  title={`${site.city} Water Quality and Hardness Report`}
  description={`${site.city} water quality report. ${site.waterAuthority} delivers ${site.gpgLow}–${site.gpgHigh} GPG water to every ${site.city} home. Full hardness data, WQA classification, and treatment recommendations.`}
>
  <PageHero
    breadcrumbs={[{ label: "Water Quality" }]}
    heading={`${site.city} Water Quality Report | Trusted Local Specialists`}
    image={headerImage}
    primaryCta={primaryCta}
    secondaryCta={{ href: "/quote/", text: "Get a Free Quote" }}
  >
    <p slot="opening">
      <a href="/" class="brand-link">Water Softeners of {site.city}</a>
      {" "}offers professional water hardness testing and quality reporting across {site.city} and {site.county}, at
      {" "}{site.gpgLow}–{site.gpgHigh} GPG, such as free in-home tests, ZIP-level reports, and lab-verified readings.
      {" "}{site.waterAuthority} delivers {site.waterSource} to every {site.city} home, classified as {site.gpgLabel}
      {" "}by the Water Quality Association. Free in-home water hardness test included with every consultation. Results
      confirmed on the spot. No obligation to proceed.
    </p>
  </PageHero>

  <section class="section">
    <div class="container">

      <div class="section-header">
        <h2>{site.city}'s Water Source and Authority</h2>
        <p>{site.waterAuthority} sources {site.city}'s public water supply from {site.waterSource} and manages it directly. Per {site.waterAuthority}'s own service data, homes across {site.county} see hardness levels of {site.gpgLow}–{site.gpgHigh} grains per gallon (GPG), classified as {site.gpgLabel} — see the classification table below for what that means.</p>
      </div>

      <div class="grid grid-2">
        <div class="card">
          <h3>Water Source</h3>
          <p>This supply is {site.waterSource}.</p>
        </div>
        <div class="card">
          <h3>Managing Authority</h3>
          <p>{site.waterAuthority} manages this supply.</p>
        </div>
      </div>
    </div>
  </section>

  <QuickFacts />

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header">
        <h2>Understanding {site.gpgLabel} Water</h2>
        <p>Water hardness is measured in grains per gallon (GPG) of dissolved calcium and magnesium. {site.city}'s {site.gpgLow}–{site.gpgHigh} GPG range falls in the "{site.gpgLabel}" category, per the Water Quality Association scale below.</p>
      </div>
      <table class="data-table">
        <thead>
          <tr><th>GPG Range</th><th>Classification</th></tr>
        </thead>
        <tbody>
          <tr><td>0 – 1 GPG</td><td>Soft</td></tr>
          <tr><td>1 – 3.5 GPG</td><td>Slightly Hard</td></tr>
          <tr><td>3.5 – 7 GPG</td><td>Moderately Hard</td></tr>
          <tr><td>7 – 10.5 GPG</td><td>Hard</td></tr>
          <tr><td>10.5+ GPG</td><td>Very Hard</td></tr>
          <tr class="highlight"><td>{site.gpgLow}–{site.gpgHigh} GPG</td><td>{site.city}, {site.stateAbbr} ({site.gpgLabel})</td></tr>
        </tbody>
      </table>
      <p class="table-footnote">The Water Quality Association reports anything above 10.5 GPG as Very Hard — get a free water test to confirm your own reading.</p>
    </div>
  </section>

  <GPGSlider />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Hardness by ZIP Code</h2>
        <p>{site.city} ZIP codes see {site.gpgLow}–{site.gpgHigh} GPG readings citywide, with only slight variation by distribution line. Approximate figures for {site.city} ZIP codes appear below:</p>
      </div>
      <table class="data-table">
        <thead>
          <tr><th>ZIP Code</th><th>Approx. Hardness</th></tr>
        </thead>
        <tbody>
          {site.zipCodes.map((zip) => (
            <tr>
              <td>{zip}</td>
              <td>{site.gpgLow}–{site.gpgHigh} GPG ({site.gpgLabel})</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="table-footnote">{site.waterAuthority} reports these figures for every {site.city} ZIP code above — find out your exact reading with a free in-home test.</p>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container final-cta">
      <h2>Get Your Exact Hardness Reading</h2>
      <p>Book a <a href="/free-water-test/">free in-home water test</a> to know exactly what {site.city} water is doing to your plumbing. {site.waterAuthority} reports the citywide figure, but only an in-home test confirms yours — get a free water softener quote today.</p>
      <a class="btn btn-primary" href="/quote/">Get a Free Water Softener Quote in Indianapolis</a>
    </div>
  </section>

  <style>
    .highlight td { background: var(--color-primary-light); color: var(--color-primary-dark); font-weight: 700; }
    .table-footnote { margin-top: 16px; font-size: 0.85rem; color: var(--color-text-muted); }
    .final-cta { text-align: center; }
    .final-cta p { max-width: 48ch; margin: 0 auto 24px; }
  </style>
</Layout>
