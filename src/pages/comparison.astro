---
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import GPGSliderMini from "../components/GPGSliderMini.astro";
import QuickFacts from "../components/QuickFacts.astro";
import { site } from "../lib/site";
import headerImage from "../assets/images/comparison-header.webp";

const primaryCta = site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER"
  ? { href: `tel:${site.phoneNumber}`, text: `📞 ${site.phoneNumber}` }
  : { href: "/contact/", text: "📞 Call for a Free Consultation" };
---

<Layout
  title={`Best Water Softener in ${site.city}, ${site.stateAbbr}`}
  description={`Salt-based vs salt-free vs reverse osmosis water softeners in ${site.city}, ${site.stateAbbr}. Which system works at ${site.gpgLow}–${site.gpgHigh} GPG. Free system recommendation with every water test.`}
>
  <PageHero
    breadcrumbs={[{ label: "System Comparison" }]}
    heading={`Best Water Softener in ${site.city}, ${site.stateAbbr} | Trusted Local Specialists`}
    image={headerImage}
    primaryCta={primaryCta}
    secondaryCta={{ href: "/quote/", text: "Get a Free Water Softener Quote in Indianapolis" }}
  >
    <p slot="opening">
      <a href="/" class="brand-link">Water Softeners of {site.city}</a>
      {" "}compares water softener types — such as salt-based, salt-free, and dual-tank systems — for
      {" "}{site.city} homeowners. At {site.gpgLow}–{site.gpgHigh} GPG from {site.waterAuthority}, not every
      system works. Salt-free conditioners do not remove calcium and magnesium at this hardness level.
      Salt-based ion exchange removes hardness minerals completely above 10 GPG, unlike salt-free conditioners.
      Free system recommendation included with every free water test.
    </p>
  </PageHero>

  <section class="section">
    <div class="container">

      <div class="section-header">
        <p>At {site.gpgLow}–{site.gpgHigh} GPG, {site.city} homes need to weigh true softening against lower-maintenance conditioning. Here's how the two approaches compare.</p>
      </div>

      <GPGSliderMini />

      <div class="table-scroll">
        <table class="data-table">
          <caption class="table-caption">At {site.gpgLow}-{site.gpgHigh} GPG, only salt-based softening — such as ion exchange — removes both calcium and magnesium completely.</caption>
          <thead>
            <tr><th></th><th>Salt-Based Softener</th><th>Salt-Free Conditioner</th></tr>
          </thead>
          <tbody>
            <tr><td>Removes hardness minerals</td><td>Yes</td><td>No — crystallizes minerals instead</td></tr>
            <tr><td>Best for {site.gpgLabel} water</td><td>Yes</td><td>Better suited to slightly/moderately hard water</td></tr>
            <tr><td>Ongoing maintenance</td><td>Requires salt refills</td><td>No salt required</td></tr>
            <tr><td>Water waste (regeneration)</td><td>Some, modern systems are efficient</td><td>None</td></tr>
            <tr><td>Skin/hair softness benefit</td><td>Yes</td><td>Limited</td></tr>
          </tbody>
        </table>
      </div>
      <p class="section-footnote">{site.waterAuthority} reports the same {site.gpgLow}-{site.gpgHigh} GPG figure behind every row above, such as the modern demand-initiated systems we install — get a free quote for a recommendation matched to it.</p>
    </div>
  </section>

  <QuickFacts />

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header center">
        <p class="eyebrow">See Our Recommendation</p>
        <h2>SpringWell Systems for {site.city} Homes</h2>
        <p>{site.waterAuthority} reports the {site.gpgLow}-{site.gpgHigh} GPG figure these three SpringWell systems target, such as the softener, combo, and RO models below. Each covers a different need, from basic softening to full filtration, and links to current manufacturer pricing.</p>
      </div>
      <div class="grid grid-3">
        <div class="card">
          <p class="card-title">SpringWell Softener</p>
          <p>A dedicated salt-based softener sized for {site.gpgLabel.toLowerCase()} water — the most effective option for {site.city}'s {site.gpgLow}–{site.gpgHigh} GPG hardness.</p>
          <a class="btn btn-primary btn-sm" href={site.affiliateSoftener} target="_blank" rel="noopener noreferrer sponsored">Check Softener Pricing</a>
        </div>
        <div class="card">
          <p class="card-title">SpringWell Softener + Filter Combo</p>
          <p>Combines hardness removal with whole-home filtration for chlorine and sediment carried through {site.waterAuthority}'s supply.</p>
          <a class="btn btn-primary btn-sm" href={site.affiliateCombo} target="_blank" rel="noopener noreferrer sponsored">See Combo Pricing</a>
        </div>
        <div class="card">
          <p class="card-title">SpringWell Reverse Osmosis</p>
          <p>Add under-sink RO filtration for the best-tasting, cleanest drinking and cooking water.</p>
          <a class="btn btn-primary btn-sm" href={site.affiliateRO} target="_blank" rel="noopener noreferrer sponsored">Compare RO Pricing</a>
        </div>
      </div>
      <p class="disclosure">Some links above are affiliate links. We may earn a commission at no extra cost to you if you purchase through them.</p>
      <p>See the recommendation that fits {site.city}'s exact hardness reading.</p>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container final-cta">
      <h2>Not Sure Which System Fits Your Home?</h2>
      <p>Get a free recommendation based on your household size and {site.city}'s actual water hardness. {site.waterAuthority} reports the same {site.gpgLow}-{site.gpgHigh} GPG figure for every address — contact us to see your match.</p>
      <a class="btn btn-primary" href="/quote/">Get a Free Water Softener Quote in Indianapolis</a>
    </div>
  </section>

  <style>
    .table-scroll { overflow-x: auto; }
    .table-caption { caption-side: top; text-align: left; font-size: 0.9rem; color: var(--color-text-muted); margin-bottom: 8px; }
    .card-title { font-family: var(--font-heading); font-size: 1.1rem; color: var(--surface-footer); margin: 0 0 8px; }
    .section-footnote { margin-top: 16px; font-size: 0.85rem; color: var(--color-text-muted); }
    .disclosure { font-size: 0.75rem; color: var(--color-text-muted); margin-top: 24px; }
    .final-cta { text-align: center; }
    .final-cta p { max-width: 48ch; margin: 0 auto 24px; }
  </style>
</Layout>
