---
import Layout from "../../components/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import QuickFacts from "../../components/QuickFacts.astro";
import { site } from "../../lib/site";
import headerImage from "../../assets/images/resin-bed-replacement-header.webp";

const primaryCta = site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER"
  ? { href: `tel:${site.phoneNumber}`, text: `📞 ${site.phoneNumber}` }
  : { href: "/contact/", text: "📞 Call for a Free Consultation" };

const signs = [
  {
    name: "Hard Water Returning",
    detail: "Water tests hard again even right after a completed regeneration cycle — the clearest sign the resin bed itself, not just the salt level, has failed.",
  },
  {
    name: "Resin Beads in Your Water",
    detail: "Small tan or yellow granules showing up in faucet aerators, toilet tanks, or ice makers mean the resin bed is physically breaking down.",
  },
  {
    name: "Longer Regeneration Cycles",
    detail: "Cycles that run noticeably longer or more often than they used to, without a corresponding improvement in water softness.",
  },
  {
    name: "Rising Salt Usage",
    detail: "Salt consumption climbs while the water stays just as hard — the resin is no longer exchanging ions effectively.",
  },
];

const faqs = [
  {
    q: "How long does water softener resin last?",
    a: "Most resin beds last 10 to 15 years under normal conditions. Heavy iron content, chlorine or chloramine exposure, and frequent regeneration cycles all shorten that lifespan.",
  },
  {
    q: "Can I replace water softener resin myself?",
    a: "Yes, with resin matched to your tank's exact grain capacity and basic tools. Mismatched resin volume is the most common DIY error and causes premature channeling.",
  },
  {
    q: "Will replacing the resin fix a softener that stops regenerating entirely?",
    a: "Usually not. No regeneration at all typically points to the control head or timer, not the resin — that calls for a broader repair diagnosis.",
  },
  {
    q: "Is resin bed replacement covered under warranty?",
    a: "It varies by manufacturer. Opening the tank yourself can void some warranties, so check your manufacturer's terms before attempting a DIY replacement.",
  },
];
---

<Layout
  title={`Water Softener Resin Bed Replacement in ${site.city}, ${site.stateAbbr}`}
  description={`Signs your ${site.city} water softener's resin bed has failed, what replacement costs, and how the process works.`}
>
  <PageHero
    breadcrumbs={[{ label: "Repair", href: "/repair/" }, { label: "Resin Bed Replacement" }]}
    heading={`Resin Bed Replacement in ${site.city}, ${site.stateAbbr} | Trusted Local Specialists`}
    image={headerImage}
    primaryCta={primaryCta}
    secondaryCta={{ href: "/quote/", text: "Get a Free Water Softener Quote in Indianapolis" }}
  >
    <p slot="opening">
      <a href="/" class="brand-link">Water Softeners of {site.city}</a>
      {" "}offers water softener resin bed replacement at {site.gpgLow}-{site.gpgHigh} GPG, such as diagnosis,
      resin swaps, and control head reprogramming, across {site.city} and {site.county}. Resin beds typically
      last 10 to 15 years at this hardness level. A softener passing hard water despite regular regeneration
      is the primary sign of resin exhaustion. Free diagnostic included with every service call. Same day
      availability. Written quote before work begins.
    </p>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <p>A resin bed is the part of a water softener that removes calcium and magnesium. When it fails, the system keeps running but stops softening water. At {site.gpgLow}-{site.gpgHigh} GPG, {site.city} softeners — such as single-tank and dual-tank units — cycle more often than in a moderate-hardness market, which wears resin down faster than the national average.</p>
      </div>

      <h2>What Signs Mean Your Water Softener Needs a New Resin Bed</h2>
      <p>{site.waterAuthority} data shows these four signs link directly to resin failure at {site.city}'s hardness level.</p>
      <div class="grid grid-2">
        {signs.map((s) => (
          <div class="card">
            <p class="card-title">{s.name}</p>
            <p>{s.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <QuickFacts />

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header">
        <h2>Why Resin Fails Faster in {site.city}</h2>
        <p>{site.city}'s {site.gpgLow}-{site.gpgHigh} GPG water wears resin down faster than softer-water markets. Resin beads exchange ions more frequently at this hardness level, physically wearing them down sooner. Chlorine or chloramine disinfection from {site.waterAuthority} is a known additional factor in resin degradation, on top of iron fouling and bacterial buildup — see the replacement cost below for what this means for your system.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Resin Bed Replacement Cost</h2>
        <p>Resin-only replacement typically costs less than a full system swap, scaling with tank size and grain capacity. {site.waterAuthority} reports the same {site.gpgLow}-{site.gpgHigh} GPG figure behind every quote we write — we provide a free diagnostic and a written quote before any work begins, with no fixed price until we see the system first.</p>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header center">
        <h2>How Resin Bed Replacement Works</h2>
        <p>{site.waterAuthority} reports the same figure behind every step below in {site.city}'s real {site.gpgLow}-{site.gpgHigh} GPG hardness reading, across three stages.</p>
      </div>
      <div class="grid grid-3">
        <div class="process-step">
          <span class="process-number">1</span>
          <p class="card-title">Diagnose and Bypass</p>
          <p>Confirm resin failure with a water test, then shut off supply and engage the bypass valve.</p>
        </div>
        <div class="process-step">
          <span class="process-number">2</span>
          <p class="card-title">Drain and Replace</p>
          <p>Drain and open the tank, remove the old resin, flush out fines, and add new resin matched to the tank's grain capacity.</p>
        </div>
        <div class="process-step">
          <span class="process-number">3</span>
          <p class="card-title">Reprogram and Test</p>
          <p>Reassemble the control head, reprogram it, and run an initial regeneration cycle before the system goes back into service — get a free quote to schedule yours.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Resin Replacement or Whole-System Replacement?</h2>
        <p>Resin replacement usually makes sense for a system under about 8 to 10 years old that's otherwise in good condition. A control head that's also failing, or a system past its expected lifespan, usually favors full replacement. See our <a href="/repair/">Water Softener Repair and Maintenance in Indianapolis</a> page for the broader repair-vs-replace picture.</p>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header center">
        <h2>Resin Bed Replacement Questions</h2>
        <p>{site.waterAuthority} reports the same figure behind every answer below in {site.city}'s real {site.gpgLow}-{site.gpgHigh} GPG hardness reading.</p>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>
              {item.q}
              <svg class="faq-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6.5 8 10.5 12 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container final-cta">
      <h2>Water Softener Not Softening in {site.city}?</h2>
      <p>{site.waterAuthority} reports the same {site.gpgLow}-{site.gpgHigh} GPG figure behind every diagnostic — get a free in-home test to confirm whether resin failure is the cause.</p>
      <a class="btn btn-primary" href="/contact/">Book a Diagnostic →</a>
    </div>
  </section>

  <style>
    .process-step { text-align: center; padding: 0 12px; }
    .process-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: var(--radius-full, 9999px);
      background: var(--color-primary-light);
      color: var(--color-primary);
      font-family: var(--font-heading);
      font-size: 1.125rem;
      margin-bottom: 14px;
    }
    .card-title { font-family: var(--font-heading); font-size: 1.1rem; color: var(--surface-footer); margin: 0 0 8px; }
    .faq-list { max-width: 760px; margin: 24px auto 0; }
    .final-cta { text-align: center; }
    .final-cta p { max-width: 48ch; margin: 0 auto 24px; }
  </style>
</Layout>
